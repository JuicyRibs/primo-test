{
  "name": "primo-encryption-api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS AES/RSA encryption API",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "keys:generate": "node scripts/generate-keys.cjs",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && npm run start:prod",
    "start:dev": "node --watch --watch-path=src --run start",
    "start:prod": "node --env-file-if-exists=.env dist/main.js",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "test:coverage": "tsc -p tsconfig.test.json && node --test --experimental-test-coverage --test-coverage-include=\"dist-test/src/**/*.js\" \"dist-test/test/*.test.js\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
